// Day 2: Operators and Conditional Statements

// Arithmetic Operators
let a = 10
let b = 5

print(a + b)
print(a - b)
print(a * b)
print(a / b)
print(a % b)

// Comparison Operators
print(a > b)
print(a < b)
print(a == b)
print(a != b)

// Logical Operators
print(a > 5 && b < 10)
print(a < 5 || b < 10)

// If Statement
if a > b {
    print("Yes")
}

// If-Else Statement
if a < b {
    print("Yes")
} else {
    print("No")
}

// Else-If Statement
let marks = 75

if marks >= 90 {
    print("A")
} else if marks >= 70 {
    print("B")
} else {
    print("C")
}

// Switch Statement
let day = 2

switch day {
case 1:
    print("One")
case 2:
    print("Two")
default:
    print("Other")
}
