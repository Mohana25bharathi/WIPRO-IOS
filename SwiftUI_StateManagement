import SwiftUI

struct ContentView: View {

    @State private var count = 0

    var body: some View {
        VStack(spacing: 20) {

            Text("Counter App")
                .font(.largeTitle)
                .bold()

            Text("Count: \(count)")
                .font(.title)

            Button("Increase") {
                count += 1
            }

            Button("Decrease") {
                count -= 1
            }

            Button("Reset") {
                count = 0
            }
        }
        .padding()
    }
}

