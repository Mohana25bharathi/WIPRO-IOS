
import SwiftUI

struct ContentView: View {
    var body: some View {
        VStack(spacing: 20) {

            Text("My SwiftUI App")
                .font(.largeTitle)
                .bold()

            Image(systemName: "person.circle.fill")
                .resizable()
                .frame(width: 80, height: 80)
                .foregroundColor(.blue)

            HStack(spacing: 15) {
                Text("Name:")
                    .bold()

                Text("Student")
            }

            ZStack {
                RoundedRectangle(cornerRadius: 12)
                    .fill(Color.green)
                    .frame(width: 250, height: 80)

                Text("Welcome!")
                    .font(.title)
                    .foregroundColor(.white)
            }

            Button("Click Me") {
                print("Button clicked!")
            }
        }
        .padding()
    }
}

