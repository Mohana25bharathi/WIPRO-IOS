

import SwiftUI

struct ContentView: View {
    @State private var showDetails = false

    var body: some View {
        VStack(spacing: 15) {
            Image(systemName: "person.circle.fill")
                .resizable()
                .frame(width: 100, height: 100)
                .foregroundColor(.blue)

            Text("Mohana")
                .font(.title)
                .bold()

            Text("Computer Science Engineering")
                .font(.headline)

            Text("Aspiring iOS Developer")
                .foregroundColor(.gray)

            Button("View Details") {
                showDetails.toggle()
            }
            .padding()
            .background(Color.blue)
            .foregroundColor(.white)
            .cornerRadius(10)

            if showDetails {
                Text("Skills: Swift, SwiftUI, Java")
                    .font(.subheadline)

                Text("Goal: Become an iOS Developer")
                    .font(.subheadline)
            }
        }
        .padding()
    }
}

